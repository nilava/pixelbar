<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Pixelbar</string>
  <key>CFBundleIdentifier</key><string>com.pixelbar.helper</string>
  <key>CFBundleExecutable</key><string>Pixelbar</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <!-- An agent: no Dock icon, no app switcher entry. -->
  <key>LSUIElement</key><true/>
  <!-- Required since macOS 15 for anything that broadcasts, multicasts or
       connects to an address on the local subnet. Without this key the system
       does not even offer the prompt: a bundle-launched app is its own
       responsible process, discovery silently finds nothing, and the only clue
       is that the identical binary works when run from a terminal, because
       there it inherits the terminal's permission. -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Pixelbar talks to your panel over Bluetooth when Wi-Fi is not available.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Pixelbar finds your panel on this network and sends it your status.</string>
</dict>
</plist>
